{
  "manifest_version": 3,
  "name": "SpeechPoint",
  "version": "2.4",
  "description": "Use Chrome with your voice: open sites, click, type, dictate, scroll and read pages, hands-free.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "tabs", "sidePanel", "tts", "storage", "sessions", "bookmarks", "clipboardWrite", "clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "SpeechPoint — click to open",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+S", "mac": "Alt+S" },
      "description": "Open SpeechPoint"
    },
    "toggle-listening": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Start or stop listening (panel open)"
    }
  }
}
